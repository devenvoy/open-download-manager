{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Open Download Manager",
  "version": "0.1.2",
  "identifier": "com.opendownloadmanager.desktop",
  "build": {
    "frontendDist": "../renderer"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Open Download Manager",
        "width": 805,
        "height": 465,
        "minWidth": 760,
        "minHeight": 450,
        "visible": false
      }
    ],
    "security": {
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "resources": [
      "../extension/**/*"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "languages": ["en-US"]
      }
    }
  }
}
