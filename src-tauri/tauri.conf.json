{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Awesome Downloader",
  "version": "0.1.2",
  "identifier": "com.awesomedownloader.desktop",
  "build": {
    "frontendDist": "../renderer"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Awesome Downloader",
        "width": 805,
        "height": 465,
        "minWidth": 760,
        "minHeight": 450
      }
    ],
    "security": {
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": false
  }
}
