{
  "name": "open-download-manager",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Open Download Manager desktop application built with Rust and Tauri",
  "repository": {
    "type": "git",
    "url": "https://github.com/devenvoy/open-download-manager.git"
  },
  "bugs": {
    "url": "https://github.com/devenvoy/open-download-manager/issues"
  },
  "license": "MIT",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "tauri": "tauri",
    "dev": "tauri dev",
    "build": "cargo build --release --bin open-download-manager-native-host && tauri build",
    "build:mac": "cargo build --release --bin open-download-manager-native-host && tauri build --bundles dmg,app",
    "build:linux": "cargo build --release --bin open-download-manager-native-host && tauri build --bundles deb,appimage",
    "build:win": "cargo build --release --target x86_64-pc-windows-msvc --bin open-download-manager-native-host && tauri build --target x86_64-pc-windows-msvc --bundles nsis",
    "build:win:arm64": "cargo build --release --target aarch64-pc-windows-msvc --bin open-download-manager-native-host && tauri build --target aarch64-pc-windows-msvc --bundles nsis",
    "clean": "cargo clean",
    "lint": "eslint renderer/ extension/ tools/",
    "frontend:dev": "vite --config renderer/vite.config.ts",
    "frontend:build": "vite build --config renderer/vite.config.ts",
    "typecheck": "tsc --noEmit -p renderer/tsconfig.json",
    "test": "cargo test && bun run test:renderer && bun run test:extension",
    "test:renderer": "vitest run --config renderer/vitest.config.ts",
    "test:extension": "bun test ./extension",
    "pack:extension": "bun extension/pack.mjs",
    "pack:extension:firefox": "bun extension/pack.mjs",
    "pack:release": "bun tools/pack-release.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2.0.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.10",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "jsdom": "^31.0.0",
    "shadcn": "^4.23.0",
    "typescript": "5",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/react-query": "^5.107.1",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-clipboard-manager": "^2.5.0",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@vitejs/plugin-react": "^6.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.72.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.5",
    "vite": "^8.3.8",
    "zustand": "^5.1.0"
  }
}
